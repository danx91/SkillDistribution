<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SkillDistribution</RootNamespace>
    <Title>Skill Distribution</Title>
    <Authors>ZGFueDkx</Authors>
    <AssemblyName>SkillDistribution-Server</AssemblyName>
    <AssemblyVersion>1.3.0</AssemblyVersion>
    <Version>$(AssemblyVersion)</Version>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <Copyright>Copyright © 2026 $(Authors)</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="set &quot;dest=$(ProjectDir)..\..\..\SPT_Runtime\user\mods\$(RootNamespace)&quot;&#xD;&#xA;mkdir %25dest%25&#xD;&#xA;copy &quot;$(TargetPath)&quot; &quot;%25dest%25\$(TargetFileName)&quot;&#xD;&#xA;robocopy &quot;$(ProjectDir)\config&quot; &quot;%25dest%25\config&quot; /e&#xD;&#xA;&#xD;&#xA;set RC=%25ERRORLEVEL%25&#xD;&#xA;if %25RC%25 LEQ 7 exit /B 0&#xD;&#xA;exit /B %25RC%25" />
  </Target>

  <ItemGroup>
    <PackageReference Include="SPTushonka.Common" Version="4.1.3" />
    <PackageReference Include="SPTushonka.DI" Version="4.1.3" />
    <PackageReference Include="SPTushonka.Server.Core" Version="4.1.3" />
  </ItemGroup>

</Project>
